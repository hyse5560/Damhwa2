# MySQL
DB_NAME=damhwa
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Node.js 서버
PORT=3000

# 로그인 토큰 서명용 개발 키
AUTH_TOKEN_SECRET=change_this_dev_secret

# 관리자 API 보호용 키
ADMIN_KEY=change_this_admin_key

# OpenAI / Google Cloud는 실제 연동 시에만 입력
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase FCM은 실제 json 파일이 있을 때만 입력
# FCM_SERVICE_ACCOUNT_PATH=./src/config/firebase-service-account.json
